shape Entry
  path: string
  name: string
  depth: number
  directory: bool
  expanded: bool

shape Recent
  path: string
  name: string
  kind: string

shape Workspace
  root: string
  activePath: string
  activeName: string
  scanning: bool
  scanCount: number
  error: string
  entries: Entry[]
  recent: Recent[]
  editorUrl: string

shape Reply
  ok: bool
  error: string

shape PickerSupport
  available: bool

component ExactDraw
  state path = ""
  state query = ""
  state sidebarOpen = true
  resource nativePicker = pickerAvailable() as shape PickerSupport else empty()
  resource workspace = loadWorkspace(query) as shape Workspace else empty(activeName="No drawing open")
  mutation changed as shape Reply queue refreshes workspace
  derive actionError = match changed { case some(r) => r.error, case none => "" }
  task poll mount
    every(1500, refreshWorkspace)
  action toggleSidebar
    sidebarOpen = not sidebarOpen
  action refreshWorkspace
    refresh workspace
  action editPath(value: string)
    path = value
  action search(value: string)
    query = value
  action openPath
    if path.trim() != ""
      send changed = openLocation(path.trim())
  action browse(kind: string)
    send changed = chooseLocation(kind)
  action openRecent(value: string)
    send changed = openLocation(value)
  action activate(value: string, directory: bool)
    if directory
      send changed = toggleFolder(value)
    else
      send changed = openLocation(value)
  action rescan
    send changed = rescanFolder()
  view
    main testId="app" width="100%" height="100%" display="flex" flex-direction="column" accent-color="-exact-system-indigo"
      row flex=1 min-height=0
        column width=(sidebarOpen ? 280 : 44) flex-shrink=0 padding=(sidebarOpen ? 12 : 8) gap=12 background-color="-exact-secondary-background"
          row gap=8 align-items="center"
            button press=toggleSidebar aria-label=(sidebarOpen ? "Hide sidebar" : "Show sidebar") aria-expanded=sidebarOpen testId="toggle-sidebar" width=28 height=28
              text (sidebarOpen ? "‹" : "›")
            if sidebarOpen
              text workspace.activeName flex=1 min-width=0 text-overflow="ellipsis" font="-exact-footnote" color="-exact-secondary-label" testId="active-name"
          if sidebarOpen
            text "WORKSPACE" font="-exact-caption1" color="-exact-secondary-label"
            if nativePicker.available
              button press=browse("file") disabled=pending(changed) buttonStyle="bordered" testId="open-drawing"
                text "Open drawing…"
              button press=browse("folder") disabled=pending(changed) buttonStyle="bordered" testId="open-folder"
                text "Open folder…"
            input value=path input=editPath submit=openPath placeholder="File or folder path" aria-label="File or folder path" testId="path" min-width=0
            button press=openPath disabled=(path.trim() == "") buttonStyle="bordered" testId="open"
              text "Open path"
            if actionError != ""
              text actionError color="-exact-system-red" font="-exact-footnote" testId="action-error" overflow-wrap="anywhere"
            if workspace.error != ""
              text workspace.error color="-exact-system-red" font="-exact-footnote" testId="workspace-error" overflow-wrap="anywhere"
            if workspace.root != ""
              row gap=8 align-items="center"
                text "EXPLORER" font="-exact-caption1" color="-exact-secondary-label" flex=1
                button press=rescan disabled=workspace.scanning aria-label="Refresh folder" testId="refresh-folder"
                  text "Refresh"
              input value=query input=search placeholder="Find a drawing" aria-label="Find a drawing" testId="search" min-width=0
              text (workspace.scanning ? `Discovering… ${workspace.scanCount} ${workspace.scanCount == 1 ? "drawing" : "drawings"}` : `${workspace.scanCount} ${workspace.scanCount == 1 ? "drawing" : "drawings"}`) font="-exact-footnote" color="-exact-secondary-label" testId="scan-status"
              list virtualized=true flex=1 min-height=0 testId="explorer"
                for entry in workspace.entries key=entry.path
                  row min-height=32 padding-left=(entry.depth * 14)
                    button press=activate(entry.path, entry.directory) appearance="none" aria-label=entry.path testId=`entry-${entry.path}` flex=1 min-width=0
                      row gap=6 align-items="center"
                        text (entry.directory ? (entry.expanded ? "▾" : "▸") : "◇") color="-exact-secondary-label"
                        text entry.name text-overflow="ellipsis" min-width=0 flex=1
            else
              column flex=1 justify-content="center" gap=8 padding="20px 4px"
                text "Your drawings,\nwhere they belong." font-size=22 font-weight=600
                text "Open a file to draw, or a folder to explore. Only .excalidraw files appear here." color="-exact-secondary-label" overflow-wrap="anywhere"
            if workspace.recent.length > 0
              text "RECENT LOCATIONS" font="-exact-caption1" color="-exact-secondary-label"
              list virtualized=true height=170 min-height=80 testId="recent"
                for item in workspace.recent key=item.path
                  row min-height=38
                    button press=openRecent(item.path) appearance="none" aria-label=item.path testId=`recent-${item.path}` flex=1 min-width=0
                      column gap=2
                        text item.name text-overflow="ellipsis"
                        text item.kind color="-exact-secondary-label" font="-exact-caption1"
        column flex=1 min-width=0 min-height=0
          if workspace.editorUrl != ""
            iframe src=workspace.editorUrl sandbox="allow-scripts allow-same-origin allow-downloads" flex=1 min-height=0 testId="drawing-editor"
          else
            column flex=1 align-items="center" justify-content="center" padding=24 gap=12
              text "Connecting to your workspace" font-size=24 font-weight=600
              text "Start Exact Draw with bun run start." color="-exact-secondary-label"
