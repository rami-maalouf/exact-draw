test "the desktop shell connects to the file service"
  size 1280x820
  clock data
  expect tree missing "path"
  expect tree missing "open"
  expect tree has "drawing-editor"
  tap "toggle-sidebar"
  expect state sidebarOpen == false
  expect tree missing "path"
  expect tree has "drawing-editor"
  tap "toggle-sidebar"
  expect state sidebarOpen == true
  expect tree missing "path"
