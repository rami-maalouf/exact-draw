test "the desktop shell connects to the file service"
  size 1280x820
  clock data
  expect tree missing "path"
  expect tree missing "open"
  expect tree has "drawing-editor"
  expect tree has "window-header"
  expect tree has "active-name"
  tap "toggle-sidebar"
  expect state sidebarOpen == false
  expect tree missing "sidebar"
  expect tree has "toggle-sidebar"
  expect tree has "window-header"
  expect tree has "active-name"
  expect tree missing "path"
  expect tree has "drawing-editor"
  tap "toggle-sidebar"
  expect state sidebarOpen == true
  expect tree has "sidebar"
  expect tree missing "show-sidebar"
  expect tree missing "path"
  type "toggle-sidebar" key "Meta+b"
  expect state sidebarOpen == false
  expect tree missing "sidebar"
  type "toggle-sidebar" key "Meta+b"
  expect state sidebarOpen == true
  expect tree has "sidebar"
