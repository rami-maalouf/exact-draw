{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "react",
      "react-dom"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "force"
  },
  "include": [
    "service/**/*.ts",
    "editor/**/*",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
